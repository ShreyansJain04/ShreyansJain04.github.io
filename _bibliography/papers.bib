@inproceedings{agarwal2024suppressing,
  abbr={IEEE SAUS},
  title={Suppressing Streak Artifacts Generated by the Interference of Imaging and Therapy Fields: Initial Findings Using a Hybrid U-Net and Diffusion Model},
  author={Agarwal, Mihir and Jain, Shreyans and Dhawan, Ruchika and Mistry, Nishitakumari Prafulchandra and Shekhar, Himanshu},
  booktitle={IEEE South Asian Ultrasonics Symposium},
  year={2024},
  month={March},
  abstract={We present a combined U-Net and diffusion model to remove streak artifacts in therapeutic ultrasound imaging. Using a denoising U-Net with skip connections and text-based prompts for enhanced inpainting, initial results show effective artifact removal, an improved Signal-to-Noise Ratio by 6.0 ± 3.4 dB, and an IOU score of 0.698. Rapid model convergence suggests potential for real-time clinical use. Future work will validate the model on diverse datasets and optimize performance.},
  code={https://github.com/agarwal-mihir/Fourier-StreakNet},
  pdf={streak_poster_saus2024.pdf},
  selected={true},
  preview={streak.png}
}

